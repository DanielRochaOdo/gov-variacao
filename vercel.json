{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{Mailing/**,*.pdf,*.jpeg,*.jpg,*.png,*.xlsx,*.xlsm,*.xltx,*.xltm,__pycache__/**}"
    }
  }
}
